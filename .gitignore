node_modules
dist
dist-debug
out
/artifacts/
.DS_Store
.eslintcache
*.log*
*.tsbuildinfo

# Packaged TUI Node runtime binaries (prepared by scripts/prepare-tui-runtime.cjs)
/build/tui-runtime/**
!/build/tui-runtime/README.md

# Concurrent-work markers (AGENTS.md) and the work-guard heartbeat sidecar.
# These are per-session coordination state, never source. Ignoring them keeps
# `git status --porcelain` — the check AGENTS.md tells you to trust for "is
# anything uncommitted right now" — free of coordination noise, and stops a
# stray `git add -A` from committing one session's claim into the tree.
/.WORK-IN-PROGRESS-*.md
/SHIP-HOLD-*.md
/SESSION-IN-PROGRESS-*.md
/.work-guard/

# Local-only planning/release material kept out of the public source tree
.local-only/
/website/
# Unanchored on purpose: the root-anchored form silently stopped matching when
# 298f9c2b0 moved this file into docs/, republishing what 758b47e14 had
# deliberately made private. An ignore rule must survive a move.
SECURITY_ENGINEERING_LEDGER.md
# papercuts/README.md: "This directory is intentionally tracked." The former
# per-file allowlist made every NEW papercut invisible to git until someone
# hand-edited this file - and it would not appear in `git status` to remind
# them. Local scratch notes belong in .local-only/papercuts/ instead.
papercuts/*
!papercuts/*.md
# Measurement output. Was only in this checkout's private .git/info/exclude, so
# every other clone saw it as untracked noise.
perf-artifacts/
docs/
RELEASING.md
scripts/publish-clean.sh
scripts/build-ios-simulator.cjs
scripts/check-codexbridge-seam.cjs
scripts/smoke-apns-push.cjs
scripts/validate-remote-ios-fixtures.cjs
scripts/validate-remote-ios-release.cjs
tests/fixtures/remote-ios/

# Secrets / credentials — never commit
.env
.env.*
!.env.example
*.p8
*.p12
*.pfx
*.pem
*.key
*.cer
*.mobileprovision
*.keystore

# Swift build output (was committed into history once — keep it out now)
**/.build/
ios/TaskWraithApp/build/

# Local agent / session state
.WORK-IN-PROGRESS-*.md
SHIP-HOLD-*.md
SESSION-IN-PROGRESS-*.md
.claude/
.cursor/
/.fixpass*
/.wsa-*

# Nested TaskWraith fan-out worktrees must never live inside the main checkout
.taskwraith-worktrees/
.tmp_vitest/
