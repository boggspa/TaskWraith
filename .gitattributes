# Normalize line endings on checkout/commit so Windows CI does not get CRLF.
# The tree is developed on macOS and is already all-LF in the index; this only
# pins future (especially Windows) checkouts to LF and prevents CRLF re-entry.
* text=auto eol=lf

# Binary assets: never touch (text=auto already detects these; explicit for safety).
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.wasm binary

# Preserve the upstream Emscripten license byte-for-byte, including its lone
# historical trailing space, without presenting that legal text as a source diff error.
resources/emulator/homebrew-demo/LICENSES/Emscripten-MIT-AND-NCSA.txt -whitespace

# The generated Emscripten module is hash-pinned and ignored by Prettier; keep
# its exact generated whitespace while still checking all authored bundle files.
resources/emulator/**/twgb.mjs -whitespace

# Windows-only helper scripts genuinely need CRLF.
*.ps1 text eol=crlf
